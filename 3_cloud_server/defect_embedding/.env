# Database connection (PostgreSQL + pgvector)
DATABASE_URL=postgresql+psycopg2://postgres:999@localhost:5432/visual_inspection_bulong

# Embedding model (timm)
MODEL_NAME=vit_small_patch14_dinov2.lvd142m

# Lưu file ảnh (server-side)
UPLOAD_DIR=uploads

# Device: "cuda", "cpu", hoặc "mps" (cho Mac M1/M2)
DEVICE=cpu

# Embedding dimension (DINOv2 ViT-S/14 = 384)
EMBEDDING_DIM=384

# Table name
TABLE_NAME=qc_productphotolibrary

# Index config
ENABLE_IVFFLAT_INDEX=true
IVFFLAT_LISTS=100
IVFFLAT_DISTANCE=cosine
